  <script>
    // ── COUNTER ANIMATION
    function animateCounter(el) {
      const target = parseInt(el.dataset.count);
      const suffix = el.dataset.suffix || (target === 3 ? 'M+' : target === 475 ? '+' : target === 45 ? '+' : '');
      let start = 0;
      const duration = 1800;
      const step = timestamp => {
        if (!start) start = timestamp;
        const progress = Math.min((timestamp - start) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(ease * target) + (progress >= 1 ? (target === 3 ? 'M+' : '+') : '');
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    const counters = document.querySelectorAll('[data-count]');
    const counterObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { animateCounter(e.target); counterObs.unobserve(e.target); } });
    }, { threshold: .3 });
    counters.forEach(c => counterObs.observe(c));

    // ── FADE IN ON SCROLL
    const fadeEls = document.querySelectorAll('.fade-up');
    const fadeObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); fadeObs.unobserve(e.target); } });
    }, { threshold: .1 });
    fadeEls.forEach(el => fadeObs.observe(el));

    // ── CALCULATOR
    let model = 'fofo';

    function setModel(m) {
      model = m;
      document.getElementById('btn-fofo').classList.toggle('active', m === 'fofo');
      document.getElementById('btn-foco').classList.toggle('active', m === 'foco');
      updateCalc();
    }

    function fmt(n) {
      if (n >= 100) return '₹' + (n / 100).toFixed(1) + 'Cr';
      return '₹' + n.toFixed(1) + 'L';
    }

    function updateCalc() {
      const sales = parseInt(document.getElementById('sales-slider').value);
      document.getElementById('sales-label').textContent = '₹' + sales + ' Lakhs';

      let minRet, maxRet, paybackMin, paybackMax;
      if (model === 'fofo') {
        minRet = sales * 0.12;
        maxRet = sales * 0.18;
        paybackMin = 1.5;
        paybackMax = 3;
      } else {
        minRet = sales * 0.08;
        maxRet = sales * 0.09;
        paybackMin = 3;
        paybackMax = 5;
      }

      const annMin = minRet * 12;
      const annMax = maxRet * 12;

      document.getElementById('monthly-income').textContent = fmt(minRet) + ' – ' + fmt(maxRet);
      document.getElementById('annual-income').textContent = fmt(annMin) + ' – ' + fmt(annMax);
      document.getElementById('payback').textContent = paybackMin + ' – ' + paybackMax + ' yrs';
    }

    updateCalc();
  </script>
